# Container environment for quadlets/atlas-gb10.container (podman --env-file).
# Format: one KEY=VALUE per line, value taken literally to end of line
# (no quoting, no line continuation) - JSON lists must stay on one line.

IS_SANDBOX=1
ATLAS_KV_OVERCOMMIT=1
ATLAS_DISABLE_WATCHDOGS=1

# Categorized preseed lists: a model is ONLY accepted at the endpoint of the
# category it is listed in (400 elsewhere).
ATLAS_PRESEED_GENERATIVE=["nvidia/Qwen3-Next-80B-A3B-Thinking-NVFP4","vincentzed-hf/Qwen3-Coder-Next-NVFP4","Qwen/Qwen3-VL-30B-A3B-Instruct-FP8","nvidia/Qwen3.8-27B-NVFP4"]
ATLAS_PRESEED_EMBED=["Qwen/Qwen3-Embedding-8B","Qwen/Qwen3-VL-Embedding-8B"]
ATLAS_PRESEED_RERANK=["Qwen/Qwen3-Reranker-8B","Qwen/Qwen3-VL-Reranker-8B"]
ATLAS_PRESEED_TRANSCRIBE=["openai/whisper-large-v3"]
ATLAS_PRESEED_TRANSLATE=["google/translategemma-12b-it"]
ATLAS_PRESEED_OCR=["datalab-to/chandra-ocr-2"]
ATLAS_PRESEED_IMAGE=["Qwen/Qwen-Image-2.1"]

# Observability: anomaly pushes + SQLite event store (on the bind mount, so
# it survives container recreation).
ATLAS_NTFY_TOPIC=jonas-dgx-spark001
ATLAS_EVENT_DB=/workspace/logs/atlas-events.db

# NVMe-session-sweep configuration (tests/nvme_session_sweep.py), taken over
# 1:1 from .devpod/serve.override.yml. --kv-pool-gb 1 forces pool pressure
# (LRU eviction -> NVMe tier) and REQUIRES ATLAS_KV_OVERCOMMIT=1 above:
# 4 x 16k sequences do not fit a 1 GiB pool, boot aborts without it.
# Remove these four lines for the regular serve defaults (104416 context).
ATLAS_MEM_DEBUG=1
RUST_LOG=info,memdebug=debug
ATLAS_MAX_SEQ_LEN=16384
ATLAS_SERVE_EXTRA_ARGS=--nvme-cache-dir /var/tmp/atlas-nvme-sweep --kv-pool-gb 1
