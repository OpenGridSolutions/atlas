# Container environment for .devpod/atlas-gb10.container (podman --env-file).
# Format: one KEY=VALUE per line, value taken literally to end of line
# (no quoting, no line continuation) - JSON lists must stay on one line.

IS_SANDBOX=1
ATLAS_DISABLE_WATCHDOGS=1

# Categorized preseed lists: a model is ONLY accepted at the endpoint of the
# category it is listed in (400 elsewhere).
ATLAS_PRESEED_GENERATIVE=["nvidia/Qwen3-Next-80B-A3B-Thinking-NVFP4","vincentzed-hf/Qwen3-Coder-Next-NVFP4","Qwen/Qwen3-VL-30B-A3B-Instruct-FP8","nvidia/Qwen3.8-27B-NVFP4"]
ATLAS_PRESEED_EMBED=["Qwen/Qwen3-Embedding-8B","Qwen/Qwen3-VL-Embedding-8B"]
ATLAS_PRESEED_RERANK=["Qwen/Qwen3-Reranker-8B","Qwen/Qwen3-VL-Reranker-8B"]
ATLAS_PRESEED_TRANSCRIBE=["openai/whisper-large-v3"]
ATLAS_PRESEED_TRANSLATE=["google/translategemma-12b-it"]
ATLAS_PRESEED_OCR=["datalab-to/chandra-ocr-2"]
ATLAS_PRESEED_IMAGE=["Qwen/Qwen-Image-2.1"]

# Observability: anomaly pushes + SQLite event store (on the bind mount, so
# it survives container recreation).
ATLAS_NTFY_TOPIC=jonas-dgx-spark001
ATLAS_EVENT_DB=/workspace/logs/atlas-events.db

# NVMe session store (serve.sh passes it as --nvme-cache-dir; required). Only
# one model is in memory at a time, so a model switch drops the warm sessions
# from RAM - this store brings them back. The path is the named volume from
# atlas-gb10.container.in, so the store also survives a container restart.
ATLAS_NVME_CACHE_DIR=/var/cache/atlas-nvme

# No context-window setting here: every model's MODEL.toml names its number
# of warm sessions ([serving] sessions) and the server splits the KV pool
# evenly across them. No request time limit either: a request runs as long
# as the server generates; a server that stops generating with requests
# open ends itself (--stall-exit-s) and the unit restarts it.

# Prefill pacing: while a new prompt is read in, the sessions that are
# generating wait at most MAX_PAUSE_MS per step (the server measures each
# model and sizes the prefill chunk to fit) and keep DECODE_SHARE percent of
# the GPU time (100 = a prompt waits until nobody generates). Only applies
# while both happen at once. Comment out MAX_PAUSE_MS (or set 0) = off.
ATLAS_PREFILL_MAX_PAUSE_MS=500
ATLAS_PREFILL_DECODE_SHARE=50

# Host huge-page pool in GiB (2 MiB pages, reserved at boot by
# .devpod/install.sh - re-run it and reboot after changing this). 0 = none.
# While a pool exists the server counts only FREE HUGE PAGES as allocatable
# (NVIDIA UMA guidance), so a non-zero value belongs with a server build that
# allocates from the pool - today's build does not, and its KV pool (hence
# every session's context window) would be sized from a too-small reading.
ATLAS_HUGEPAGES_GB=0
